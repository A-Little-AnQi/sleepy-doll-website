{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sleepy-doll-api.restless-nh3.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/:page(guide|faq|changelog|developer)",
      "destination": "/docs/:page/index.html"
    }
  ],
  "trailingSlash": false
}
